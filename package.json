{
  "name": "sysflow-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@sysflow/core && npm run build --workspace=@sysflow/demo",
    "dev:core": "npm run dev --workspace=@sysflow/core",
    "dev:demo": "npm run dev --workspace=@sysflow/demo"
  }
}
